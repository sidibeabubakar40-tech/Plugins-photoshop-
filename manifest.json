{
  "manifestVersion": 5,
  "id": "com.sidibestudio.photoshop.toolkit",
  "name": "SIDIBE Photoshop Toolkit",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "sidibeToolkitPanel",
      "label": {
        "default": "SIDIBE Photoshop Toolkit"
      },
      "minimumSize": {
        "width": 260,
        "height": 360
      },
      "maximumSize": {
        "width": 900,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 520
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}