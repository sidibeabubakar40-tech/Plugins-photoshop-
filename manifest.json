{
  "manifestVersion": 5,
  "id": "com.sidibestudio.photoshop.toolkit",
  "name": "SIDIBE Photoshop Toolkit",
  "version": "3.0.0",
  "main": "index.html",
  "host": {"app": "PS", "minVersion": "23.3.0"},
  "entrypoints": [{
    "type": "panel",
    "id": "sidibeToolkitPanel",
    "label": {"default": "SIDIBE Photoshop Toolkit"},
    "minimumSize": {"width": 280, "height": 420},
    "maximumSize": {"width": 900, "height": 1400},
    "preferredDockedSize": {"width": 340, "height": 700}
  }],
  "requiredPermissions": {"localFileSystem": "fullAccess"}
}