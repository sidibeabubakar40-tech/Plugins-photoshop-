{
  "manifestVersion": 5,
  "id": "com.sidibestudio.photoshop.toolkit",
  "name": "SIDIBE Photoshop Toolkit",
  "version": "6.0.0",
  "main": "index.html",
  "host": {"app": "PS", "minVersion": "27.2.0"},
  "entrypoints": [{
    "type": "panel",
    "id": "sidibeToolkitPanel",
    "label": {"default": "SIDIBE Photoshop Toolkit"},
    "minimumSize": {"width": 280, "height": 460},
    "maximumSize": {"width": 900, "height": 1500},
    "preferredDockedSize": {"width": 340, "height": 760}
  }],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {"domains": "all"}
  }
}